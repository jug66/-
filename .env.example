# Docker Compose reads .env. Spring Boot reads OS environment variables, not this file.
# Replace before use. Never commit .env.
DATABASE_PASSWORD=replace_with_a_long_random_local_password
# API environment:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/message_board
# DATABASE_USER=message_board
# DATABASE_PASSWORD=the_same_password_as_above
# CURSOR_SECRET=at_least_32_bytes_of_random_secret
# COOKIE_SECURE=true   # HTTPS only; leave false for localhost HTTP
# ADMIN_USER_IDS=comma_separated_existing_user_uuids
# REQUIRE_STABLE_SECRETS=true # required for production profile
# UPLOAD_USER_DAILY_BYTES=104857600
# UPLOAD_PENDING_BYTES=52428800
